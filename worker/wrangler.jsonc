
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "academica-course-reminder",
  "main": "src/index.js",
  "compatibility_date": "2026-09-27",

  "kv_namespaces": [
    {
      "binding": "SENT_KV",
      "id": "b0c65a1e96d145a9b6238fb2fed7c42f"
    }
  ],

  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },

  "vars": {
    "TELEGRAM_CHAT_IDS": "-1003815793685,-1004367799048"
  },

  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  }
}
